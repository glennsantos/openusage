<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Keys must match Dark.xaml; ThemeManager swaps one dictionary for the other. -->
    <SolidColorBrush x:Key="PanelBackground" Color="#F2F2F2F7" />
    <SolidColorBrush x:Key="PanelBorder" Color="#1F000000" />
    <SolidColorBrush x:Key="CardBackground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="PrimaryText" Color="#FF1C1C1E" />
    <SolidColorBrush x:Key="SecondaryText" Color="#FF6C6C70" />
    <SolidColorBrush x:Key="TrackBrush" Color="#FFE5E5EA" />
    <SolidColorBrush x:Key="HoverBackground" Color="#14000000" />
    <SolidColorBrush x:Key="ErrorText" Color="#FFD70015" />
    <SolidColorBrush x:Key="WarningText" Color="#FFB45309" />
</ResourceDictionary>
